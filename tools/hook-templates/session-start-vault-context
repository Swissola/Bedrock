#!/usr/bin/env bash
# SessionStart hook: auto-loads this repo's own vault context - its repo doc
# (repos/<name>/index.md by default), plus the latest daily note about this
# repo from each contributor - at the start of a session in THIS repo, so work
# resumes without re-explaining anything or remembering to ask for /vault-context.
#
# This is a DIFFERENT hook from session-start-vault-check: that one fires
# everywhere (user-scope) and only ever reminds you the vault has unpushed
# commits, it never loads content. This one is opt-in PER REPO, same model
# as post-merge - installed via that specific repo's own project-level
# .claude/settings.json, not user scope, so it only fires in repos that have
# deliberately asked for it. Install either, both, or neither; see
# docs/automation.md.
#
# Because Claude Code project settings ARE version-controlled (unlike git
# hooks, which never are), this can genuinely be committed into that other
# repo's own tracked .claude/settings.json and shared with the whole team in
# one commit - but only if VAULT_ROOT resolves the same way on every
# contributor's machine (e.g. everyone clones the vault to the same path by
# convention). If your team's vault path isn't consistent across machines,
# keep this a manual per-machine step instead, the same as
# session-start-vault-check already is.
#
# Reads the vault directly off disk rather than via mcp__obsidian__* tools -
# a deliberate exception to the MCP-only convention in
# obsidian-vault-conventions: this is plumbing that runs before the model's
# own tool-calling loop begins, not an in-session action, and the vault is a
# plain directory on disk regardless of how the model itself is told to
# access it.
#
# Silent no-op if this repo has no repo doc yet (not opted in, or not
# bootstrapped) - same precondition as post-merge: run /vault-populate (or ask
# your assistant directly) first. Where that doc and the daily notes live, how
# notes are named and how the repo name is cased can be changed per vault with
# `reposPath`, `dailyNotesPath`, `filenamePattern` and `repoNameCase` in an
# optional vault-config.md, see docs/vault-config.md; the defaults are
# described there.
#
# WHICH REPO. The repo name is the name of the folder the repo lives in (the
# main checkout, so a linked worktree gets the same name as its main one), the
# same name the vault commands use, lowercased unless repoNameCase is `keep`.
# It is not taken from the git remote: a remote can be spelt differently from
# the folder, and the commands never look at it.
#
# WHICH NOTES. The default filenamePattern is {date}-{repo}-{topic}. When it
# contains {repo}, only notes whose filename matches the pattern for THIS repo
# are considered, so a busy day in another repo cannot push this repo's last
# session out. Where one repo's name is the start of another's (widget and
# widget-ui) a note belongs to the longest known name, so widget does not claim
# widget-ui's notes. The known names are the entries found under the part of
# reposPath before {repo}. Without {repo} in the pattern there is nothing to
# tell repos apart by and every note is a candidate.
#
# WHOSE NOTES. When dailyNotesPath contains {author}, each subfolder of its base
# is one contributor. YOUR latest note (the folder named after git config
# user.name, slugged as /vault-log does) is always loaded, first, then the latest
# note from each other contributor, most recent first, up to
# CONTEXT_MAX_CONTRIBUTORS (default 3) of them. So a solo install loads one note
# and a team of four up to four. Otherwise everything is one group and just the
# latest note is loaded. "Latest" is the newest date in
# the filename, then the newest file modification time among notes sharing that
# date: a git checkout stamps every file with the time it was pulled, so the
# modification time alone would mean "last pulled", not "last written". Hidden
# files, anything that is not .md and Syncthing conflict copies are never
# candidates.
#
# Skips entirely on a mid-session /compact and on a /resume. Claude Code passes
# {"source": "startup"|"resume"|"clear"|"compact"|"fork", ...} on stdin; a
# /compact's own summary, and a resumed session's transcript, already carry
# whatever this hook injected earlier in the same session, so re-injecting
# here is pure duplication with no fidelity gained. startup and clear still load. Fails open (still injects) on malformed or missing stdin
# rather than risk silently skipping a genuine session start - the safer
# failure mode for a hook whose entire job is not letting context go missing.
#
# Each note is loaded trimmed to its two forward-looking sections only
# ("## Context for Future Sessions", "## Open Questions / Next Steps", from
# the template in runbooks/using-the-vault.md) - the historical sections
# stay in the vault, reachable on request, not needed automatically every
# session. Falls back to loading the full note if neither forward-looking
# section is present (an older note, or one that's pure history), rather
# than silently showing nothing.
#
# If a note also has appended "## Update ..." sections (what /vault-log adds
# when a note for the same session already exists), the MOST RECENT one is
# loaded too, capped at UPDATE_MAX_LINES (default 40) lines, with a count of any
# earlier updates left out. An append can't rewrite the forward-looking
# sections, so without this the latest state never reached the next session.

set -u

STDIN_JSON=$(cat 2>/dev/null)
SOURCE=$(printf '%s' "$STDIN_JSON" | grep -o '"source"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | sed -E 's/.*"([^"]*)"$/\1/')
case "$SOURCE" in compact|resume) exit 0 ;; esac

# Must be passed in, not derived - unlike post-merge, this script's cwd is
# always some OTHER repo, never the vault itself, so `git rev-parse
# --show-toplevel` here would resolve to the wrong repo entirely.
VAULT_ROOT="${VAULT_ROOT:-}"
[ -z "$VAULT_ROOT" ] && exit 0

# Optional per-vault settings (docs/vault-config.md), read from the frontmatter
# of vault-config.md at the vault root. With no such file, or no such key, the
# defaults below apply. Parsed in plain bash because this hook runs before any
# MCP tool is available. A config whose frontmatter has no closing `---` is
# ignored entirely, rather than guessing where it ends.
config_value() {
  [ -f "$VAULT_ROOT/vault-config.md" ] || return 0
  tr -d '\r' < "$VAULT_ROOT/vault-config.md" | awk -v k="$1" '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { closed = 1; exit }
    { lines[++n] = $0 }
    END {
      if (!closed) exit
      for (i = 1; i <= n; i++) if (index(lines[i], k ":") == 1) {
        v = substr(lines[i], length(k) + 2)
        sub(/^[ \t]+/, "", v); sub(/[ \t]+#.*$/, "", v); sub(/[ \t]+$/, "", v)
        if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
        print v; exit
      }
    }'
}

# A configured path must stay inside the vault: relative, no `..`, no drive.
safe_rel() {
  case "$1" in ""|/*|[A-Za-z]:*|*..*) return 1 ;; esac
  return 0
}

# --- which repo --------------------------------------------------------------

# The folder of the repo's main checkout. In a linked worktree the git common
# directory is still the main checkout's .git, so a worktree named after its
# branch does not become a different repo. Falls back to the top of the
# working tree, then to the working directory itself outside any repo.
repo_folder() {
  local start common top
  start="${CLAUDE_PROJECT_DIR:-.}"
  common="$(cd "$start" 2>/dev/null && git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  case "$common" in
    */.git) printf '%s' "${common%/.git}"; return 0 ;;
  esac
  top="$(cd "$start" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)"
  if [ -n "$top" ]; then printf '%s' "$top"; else (cd "$start" 2>/dev/null && pwd); fi
  return 0
}

REPO_NAME="$(basename "$(repo_folder)")"
case "$(config_value repoNameCase)" in
  keep) ;;
  *) REPO_NAME="$(printf '%s' "$REPO_NAME" | tr '[:upper:]' '[:lower:]')" ;;
esac

REPOS_PATH="$(config_value reposPath)"
safe_rel "$REPOS_PATH" || REPOS_PATH="repos/{repo}/index.md"
INDEX_REL="${REPOS_PATH//\{repo\}/$REPO_NAME}"
INDEX_FILE="$VAULT_ROOT/$INDEX_REL"

[ -f "$INDEX_FILE" ] || exit 0

# --- which notes -------------------------------------------------------------

# Daily notes are scanned from the part of dailyNotesPath before its first
# placeholder, so `daily-notes/{author}` scans every contributor's subfolder
# and a flat `Inbox/daily-notes` scans just that folder.
DAILY_PATH="$(config_value dailyNotesPath)"
safe_rel "$DAILY_PATH" || DAILY_PATH="daily-notes/{author}"
DAILY_BASE="${DAILY_PATH%%\{*}"
DAILY_BASE="${DAILY_BASE%/}"
[ -n "$DAILY_BASE" ] || DAILY_BASE="daily-notes"
DAILY_DIR="$VAULT_ROOT/$DAILY_BASE"
HAS_AUTHOR=0
case "$DAILY_PATH" in *"{author}"*) HAS_AUTHOR=1 ;; esac

NAME_PATTERN="$(config_value filenamePattern)"
[ -n "$NAME_PATTERN" ] || NAME_PATTERN="{date}-{repo}-{topic}"
REPO_FILTERED=0
case "$NAME_PATTERN" in *"{repo}"*) REPO_FILTERED=1 ;; esac

# The filename glob for notes about repo $1: the pattern with {repo} replaced by
# that name and every other {placeholder} a wildcard. Glob characters in the
# repo name itself are escaped so they match literally.
glob_for() {
  local repo_glob g
  repo_glob="$(printf '%s' "$1" | sed 's/[][*?\\]/\\&/g')"
  g="${NAME_PATTERN//\{repo\}/$repo_glob}"
  g="$(printf '%s' "$g" | sed -E 's/\{[A-Za-z]+\}/*/g')"
  printf '%s.md' "$g"
  return 0
}

# The names of the repos the vault documents, one per line, cased per
# repoNameCase, plus this repo. Found by listing the entries under the part of
# reposPath before {repo} and stripping the part after it. A reposPath with no
# {repo} names one fixed doc, so there is nothing to list.
known_repos() {
  local base after entry name keep=0
  [[ "$(config_value repoNameCase)" == keep ]] && keep=1
  if [[ "$REPOS_PATH" == *"{repo}"* ]]; then
    base="${REPOS_PATH%%\{repo\}*}"
    after="${REPOS_PATH#*\{repo\}}"
    for entry in "$VAULT_ROOT/$base"*; do
      entry="${entry##*/}"
      case "$after" in
        /*) [[ -e "$VAULT_ROOT/$base$entry$after" ]] || continue; name="$entry" ;;
        *) [[ -n "$after" && "$entry" == *"$after" ]] || continue; name="${entry%"$after"}" ;;
      esac
      [[ -n "$name" ]] || continue
      if [[ "$keep" = 1 ]]; then printf '%s\n' "$name"; else printf '%s\n' "$name" | tr '[:upper:]' '[:lower:]'; fi
    done
  fi
  printf '%s\n' "$REPO_NAME"
  return 0
}

# With {repo} in the pattern: the glob for this repo, and the globs of every
# longer known repo whose name starts with this one's plus a hyphen. A note that
# matches one of those belongs to the longer repo.
CURRENT_GLOB="*.md"
LONGER_GLOBS=()
ALL_GLOBS=()
if [[ "$REPO_FILTERED" = 1 ]]; then
  CURRENT_GLOB="$(glob_for "$REPO_NAME")"
  while IFS= read -r known; do
    [[ -n "$known" ]] || continue
    ALL_GLOBS+=("$(glob_for "$known")")
    if [[ "$known" != "$REPO_NAME" && "$known" == "$REPO_NAME-"* ]]; then
      LONGER_GLOBS+=("$(glob_for "$known")")
    fi
  done < <(known_repos)
fi

# belongs_to_repo <filename>: exit 0 if the note is about this repo.
belongs_to_repo() {
  local name="$1" g
  # The unquoted expansions below are deliberate: the globs are the patterns.
  # shellcheck disable=SC2254
  case "$name" in $CURRENT_GLOB) ;; *) return 1 ;; esac
  if [[ ${#LONGER_GLOBS[@]} -gt 0 ]]; then
    for g in "${LONGER_GLOBS[@]}"; do
      # shellcheck disable=SC2254
      case "$name" in $g) return 1 ;; esac
    done
  fi
  return 0
}

# Who you are: the author folder name /vault-log uses, from git config user.name
# (lowercased, spaces to hyphens). Empty when no name is set, in which case no
# note counts as yours.
AUTHOR_SLUG="$(cd "${CLAUDE_PROJECT_DIR:-.}" 2>/dev/null && git config user.name 2>/dev/null | tr '[:upper:]' '[:lower:]' | tr ' ' '-')"

MAX_CHARS="${CONTEXT_MAX_CHARS:-12000}"
case "$MAX_CHARS" in ""|*[!0-9]*|0) MAX_CHARS=12000 ;; esac
MAX_ITEMS="${CONTEXT_MAX_OPEN_ITEMS:-10}"
case "$MAX_ITEMS" in ""|*[!0-9]*|0) MAX_ITEMS=10 ;; esac
STALE_DAYS="$(config_value staleOpenItemDays)"
case "$STALE_DAYS" in ""|*[!0-9]*) STALE_DAYS=30 ;; esac

MAX_CONTRIBUTORS="${CONTEXT_MAX_CONTRIBUTORS:-3}"
case "$MAX_CONTRIBUTORS" in ""|*[!0-9]*|0) MAX_CONTRIBUTORS=3 ;; esac

TAB="$(printf '\t')"

# Modification time in seconds, GNU or BSD stat.
if stat -c %Y / >/dev/null 2>&1; then STAT_FLAVOUR=gnu; else STAT_FLAVOUR=bsd; fi
mtime_of() {
  if [ "$STAT_FLAVOUR" = gnu ]; then stat -c %Y "$1" 2>/dev/null; else stat -f %m "$1" 2>/dev/null; fi
  return 0
}

# The latest note in one folder (searched recursively), as
# "<date><TAB><mtime><TAB><path>", or nothing. The date comes from the filename,
# so no process is started per note; only notes sharing the newest date are
# asked for a modification time.
DATE_RE='([0-9]{4}-[0-9]{2}-[0-9]{2})'
latest_in() {
  local dir="$1" f name d best="" tied="" m best_m=-1 best_f=""
  while IFS= read -r f; do
    name="${f##*/}"
    belongs_to_repo "$name" || continue
    d="0000-00-00"
    if [[ "$name" =~ $DATE_RE ]]; then d="${BASH_REMATCH[1]}"; fi
    if [ -z "$best" ] || [[ "$d" > "$best" ]]; then best="$d"; tied="$f"
    elif [ "$d" = "$best" ]; then tied="$tied
$f"
    fi
  done < <(cd "$dir" 2>/dev/null && find . -type f -name '*.md' ! -name '*.sync-conflict-*' ! -path '*/.*' 2>/dev/null)
  [ -n "$best" ] || return 0
  while IFS= read -r f; do
    m="$(mtime_of "$dir/${f#./}")"
    m="${m:-0}"
    if [ "$m" -gt "$best_m" ]; then best_m="$m"; best_f="$f"; fi
  done <<EOF
$tied
EOF
  printf '%s%s%s%s%s\n' "$best" "$TAB" "$best_m" "$TAB" "$dir/${best_f#./}"
  return 0
}

# One line per contributor: "<date><TAB><mtime><TAB><path><TAB><contributor>".
CANDIDATES=""
if [ -d "$DAILY_DIR" ]; then
  if [ "$HAS_AUTHOR" = 1 ]; then
    while IFS= read -r dir; do
      line="$(latest_in "$dir")"
      [ -n "$line" ] && CANDIDATES="$CANDIDATES$line$TAB${dir##*/}
"
    done < <(find "$DAILY_DIR" -mindepth 1 -maxdepth 1 -type d ! -name '.*' 2>/dev/null)
  else
    line="$(latest_in "$DAILY_DIR")"
    [ -n "$line" ] && CANDIDATES="$line$TAB
"
  fi
fi

# Most recent first: newest date, then newest modification time. Your own latest
# note is always loaded, first; CONTEXT_MAX_CONTRIBUTORS then limits how many
# OTHER contributors are loaded after it. TOTAL counts the others.
SELECTED=""
TOTAL=0
ALL_SORTED=""
if [[ -n "$CANDIDATES" ]]; then
  ALL_SORTED="$(printf '%s' "$CANDIDATES" | sort -t "$TAB" -k1,1r -k2,2nr)"
  MINE=""
  OTHERS="$ALL_SORTED"
  if [[ -n "$AUTHOR_SLUG" ]]; then
    MINE="$(printf '%s\n' "$ALL_SORTED" | awk -F"$TAB" -v me="$AUTHOR_SLUG" '$4 == me')"
    OTHERS="$(printf '%s\n' "$ALL_SORTED" | awk -F"$TAB" -v me="$AUTHOR_SLUG" '$4 != me')"
  fi
  TOTAL="$(printf '%s\n' "$OTHERS" | grep -c . || true)"
  SELECTED="$(printf '%s\n%s\n' "$MINE" "$(printf '%s\n' "$OTHERS" | head -n "$MAX_CONTRIBUTORS")" | grep . || true)"
fi

# --- older notes -------------------------------------------------------------

# An "older" note is one whose name matches no known repo's glob: written before
# repo names went into filenames. When this repo has no notes of its own, the
# newest older note is loaded in its place, labelled as such.
is_older_note() {
  local name="$1" g
  for g in "${ALL_GLOBS[@]}"; do
    # The unquoted expansion is deliberate: the glob is the pattern.
    # shellcheck disable=SC2254
    case "$name" in $g) return 1 ;; esac
  done
  return 0
}

# The repo named in a note's frontmatter, cased per repoNameCase, or nothing.
fm_repo() {
  local v
  v="$(tr -d '\r' < "$1" | awk '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    /^repo:/ { v = $0; sub(/^repo:[ \t]*/, "", v); sub(/[ \t]+$/, "", v); gsub(/^["\047]|["\047]$/, "", v); print v; exit }
  ')"
  if [[ "$(config_value repoNameCase)" == keep ]]; then printf '%s' "$v"; else printf '%s' "$v" | tr '[:upper:]' '[:lower:]'; fi
  return 0
}

OLDER_PATH=""
OLDER_NOTE_LINE=""
OLDER_LABEL="Older note (repo unknown, written before per-repo notes)"

# Sets SELECTED and ALL_SORTED to the note to load, if there is one. The newest
# five older notes (by filename date, then modification time) are the only ones
# whose frontmatter is read: one naming another repo is skipped, one naming this
# repo is this repo's own note, one naming nothing is loaded as an older note.
older_fallback() {
  local f name d who cands="" n=0 d5 tied="" m line r path
  [[ -d "$DAILY_DIR" ]] || return 0
  while IFS= read -r f; do
    name="${f##*/}"
    is_older_note "$name" || continue
    d="0000-00-00"
    if [[ "$name" =~ $DATE_RE ]]; then d="${BASH_REMATCH[1]}"; fi
    who=""
    if [[ "$HAS_AUTHOR" = 1 && "${f#./}" == */* ]]; then who="${f#./}"; who="${who%%/*}"; fi
    cands="$cands$d$TAB$f$TAB$who
"
    n=$((n + 1))
  done < <(cd "$DAILY_DIR" 2>/dev/null && find . -type f -name '*.md' ! -name '*.sync-conflict-*' ! -path '*/.*' 2>/dev/null)
  [[ "$n" -gt 0 ]] || return 0
  d5="$(printf '%s' "$cands" | sort -t "$TAB" -k1,1r | head -n 5 | tail -n 1 | cut -f1)"
  while IFS="$TAB" read -r d f who; do
    [[ -n "$f" ]] || continue
    m="$(mtime_of "$DAILY_DIR/${f#./}")"
    tied="$tied$d$TAB${m:-0}$TAB$DAILY_DIR/${f#./}$TAB$who
"
  done < <(printf '%s' "$cands" | awk -F"$TAB" -v d="$d5" '$1 >= d')
  OLDER_NOTE_LINE="(at least $n older note(s) have no repo in the filename)"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    path="$(printf '%s' "$line" | cut -f3)"
    r="$(fm_repo "$path")"
    if [[ -z "$r" ]]; then
      OLDER_PATH="$path"
    elif [[ "$r" = "$REPO_NAME" ]]; then
      OLDER_NOTE_LINE=""
    else
      continue
    fi
    SELECTED="$line"
    ALL_SORTED="$line"
    break
  done < <(printf '%s' "$tied" | sort -t "$TAB" -k1,1r -k2,2nr | head -n 5)
  return 0
}
if [[ "$REPO_FILTERED" = 1 && -z "$SELECTED" ]]; then older_fallback; fi

# --- output ------------------------------------------------------------------

# The output is assembled in parts first, so a size budget can be applied before
# anything is printed.
HEAD_OUT="$(
  echo "--- Vault context for $REPO_NAME (auto-loaded) ---"
  echo
  echo "## $INDEX_REL"
  cat "$INDEX_FILE"
)"

extract_section() {
  awk -v h="$2" '
    { sub(/\r$/, "") }
    $0 == h { grabbing=1; print; next }
    grabbing && /^## / { grabbing=0 }
    grabbing { print }
  ' "$1"
}

# The last "## Update ..." section of a note, up to the next "## " heading. Each
# new Update heading restarts the buffer, so what is left at the end is the
# most recent one wherever it sits in the note.
extract_last_update() {
  awk '
    /^## Update/ { buf = $0 "\n"; grabbing = 1; next }
    grabbing && /^## / { grabbing = 0 }
    grabbing { buf = buf $0 "\n" }
    END { printf "%s", buf }
  ' "$1"
}

# Cap on how much of that update is loaded (UPDATE_MAX_LINES to override).
UPDATE_MAX_LINES="${UPDATE_MAX_LINES:-40}"

# Lines that are open-item checkboxes (open, done, dropped or carried) are left
# out of every loaded note: the open-item list is the one place open items appear.
strip_checkboxes() {
  sed -E '/^- \[[ xX>-]\]/d'
  return 0
}

# The tags of a note from its first frontmatter block, whether written inline
# (tags: [a, b]) or as a list, printed as "[a, b]".
note_tags() {
  tr -d '\r' < "$1" | awk '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    intags && /^[ \t]*-[ \t]/ { v = $0; sub(/^[ \t]*-[ \t]*/, "", v); list = (list == "" ? v : list ", " v); next }
    { intags = 0 }
    /^tags:/ { v = $0; sub(/^tags:[ \t]*/, "", v); sub(/[ \t]+$/, "", v); if (v == "") { intags = 1; next } print v; done = 1; exit }
    END { if (!done && list != "") print "[" list "]" }
  '
  return 0
}

# True if a section (its heading line, then text) has any text under the heading.
has_body() {
  printf '%s\n' "$1" | sed '1d' | grep -q '[^[:space:]]'
  return $?
}

# render_note <path> <contributor, or empty> <1 if it is your own note, else 0>
# Yours: both forward-looking sections plus the latest appended update. Another
# contributor's: the context section only. Checkbox lines are left out of both.
render_note() {
  local note="$1" who="$2" mine="$3" override="${4:-}" rel label ctx_raw next_raw context next update total earlier update_note lines tags
  rel="${note#"$VAULT_ROOT/"}"
  if [[ -n "$override" ]]; then label="$override"
  elif [[ "$mine" = 1 ]]; then label="Your latest note"
  elif [ -n "$who" ]; then label="Latest note from $who"
  else label="Most recent daily note"; fi
  ctx_raw=$(extract_section "$note" "## Context for Future Sessions")
  next_raw=$(extract_section "$note" "## Open Questions / Next Steps")
  tags=$(note_tags "$note")

  if [ -n "$ctx_raw" ] || [ -n "$next_raw" ]; then
    echo
    if [[ "$mine" = 1 ]]; then
      echo "## $label: $rel (forward-looking sections only; read the note itself, or ask, for full history)"
    else
      echo "## $label: $rel (context section only; read the note itself, or ask, for full history)"
    fi
    [ -n "$tags" ] && echo "Tags: $tags"
    context=$(printf '%s\n' "$ctx_raw" | strip_checkboxes)
    [ -n "$ctx_raw" ] && has_body "$context" && { echo; echo "$context"; }
    if [[ "$mine" = 1 ]]; then
      next=$(printf '%s\n' "$next_raw" | strip_checkboxes)
      [ -n "$next_raw" ] && has_body "$next" && { echo; echo "$next"; }

      # An appended "## Update ..." section (what /vault-log adds when a note for
      # the same session already exists) can't rewrite the two sections above, so
      # without this the latest state never reached the next session and the
      # forward-looking sections could be out of date. Load the MOST RECENT update
      # only, capped, and say how many earlier ones were left out: the older ones
      # are history, which this hook deliberately doesn't load.
      update=$(extract_last_update "$note" | strip_checkboxes)
      if [ -n "$update" ]; then
        total=$(grep -c '^## Update' "$note" 2>/dev/null || true)
        earlier=$(( ${total:-1} - 1 ))
        update_note=""
        [ "$earlier" -gt 0 ] && update_note=" - $earlier earlier update(s) in the note not loaded"
        echo
        echo "## Appended to that note, most recent update (a later same-session addition; it supersedes the sections above where they differ)$update_note"
        lines=$(printf '%s\n' "$update" | wc -l | tr -d ' ')
        printf '%s\n' "$update" | head -n "$UPDATE_MAX_LINES"
        if [ "$lines" -gt "$UPDATE_MAX_LINES" ]; then
          echo "(update truncated: $((lines - UPDATE_MAX_LINES)) more lines in the note)"
        fi
      fi
    fi
  else
    echo
    echo "## $label: $rel (no forward-looking sections, loading in full)"
    [ -n "$tags" ] && echo "Tags: $tags"
    strip_checkboxes < "$note"
  fi
  return 0
}

# Days since 0000-03-01 for a YYYY-MM-DD date, in plain arithmetic (no date -d,
# which differs between GNU and BSD). Prints nothing for anything that is not a
# date, so a malformed one can never read as old.
day_number() {
  local ymd="$1" y m d era yoe doy doe
  [[ "$ymd" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]] || return 0
  y=$((10#${BASH_REMATCH[1]})); m=$((10#${BASH_REMATCH[2]})); d=$((10#${BASH_REMATCH[3]}))
  (( m >= 1 && m <= 12 && d >= 1 && d <= 31 )) || return 0
  (( m <= 2 )) && y=$((y - 1))
  era=$(( y / 400 ))
  yoe=$(( y - era * 400 ))
  doy=$(( (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1 ))
  doe=$(( yoe * 365 + yoe / 4 - yoe / 100 + doy ))
  echo $(( era * 146097 + doe ))
  return 0
}

# CONTEXT_TODAY (YYYY-MM-DD) overrides today's date; it exists for the tests.
TODAY="${CONTEXT_TODAY:-$(date +%Y-%m-%d)}"
TODAY_N="$(day_number "$TODAY")"

OPEN_ITEM_RE='^-[[:space:]]+\[ \][[:space:]]+(.*)$'
OPENED_RE='opened[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2})'

# The open items of one note, one per line: "<age in days><TAB><1 if stale><TAB>
# <owner><TAB><text>". Only "- [ ]" lines in the Open Questions section count. The
# age runs from the "opened YYYY-MM-DD" on the line, else from the note's own date.
open_items_of() {
  local note="$1" owner="$2" name fdate="" line text ref n age stale
  name="${note##*/}"
  if [[ "$name" =~ $DATE_RE ]]; then fdate="${BASH_REMATCH[1]}"; fi
  while IFS= read -r line; do
    [[ "$line" =~ $OPEN_ITEM_RE ]] || continue
    text="${BASH_REMATCH[1]}"
    text="${text%"${text##*[![:space:]]}"}"
    ref="$fdate"
    if [[ "$text" =~ $OPENED_RE ]]; then ref="${BASH_REMATCH[1]}"; fi
    # One item cannot flood the context: the text is cut at 300 characters.
    if [[ ${#text} -gt 300 ]]; then text="${text:0:300} (cut)"; fi
    age=0; stale=0
    n="$(day_number "$ref")"
    if [[ -n "$n" && -n "$TODAY_N" && "$TODAY_N" -gt "$n" ]]; then
      age=$((TODAY_N - n))
      [[ "$age" -gt "$STALE_DAYS" ]] && stale=1
    fi
    printf '%s%s%s%s%s%s%s\n' "$age" "$TAB" "$stale" "$TAB" "${owner:-unknown}" "$TAB" "$text"
  done < <(extract_section "$note" "## Open Questions / Next Steps")
  return 0
}

# The list of open items across every contributor's latest note, loaded or not.
print_open_items() {
  local _d _m path who items total age stale owner text flag
  items="$(
    while IFS="$TAB" read -r _d _m path who; do
      [[ -n "$path" ]] && open_items_of "$path" "$who"
    done <<EOF
$ALL_SORTED
EOF
  )"
  [[ -n "$items" ]] || return 0
  items="$(printf '%s\n' "$items" | sort -t "$TAB" -k2,2nr -k1,1nr)"
  total="$(printf '%s\n' "$items" | grep -c .)"
  echo
  echo "## Open items for $REPO_NAME (from each contributor's latest note; stale means open more than $STALE_DAYS days)"
  printf '%s\n' "$items" | head -n "$MAX_ITEMS" | while IFS="$TAB" read -r age stale owner text; do
    flag="${age}d"
    [[ "$stale" = 1 ]] && flag="${age}d, stale"
    echo "- $owner ($flag): $text"
  done
  if [[ "$total" -gt "$MAX_ITEMS" ]]; then echo "(and $((total - MAX_ITEMS)) more)"; fi
  return 0
}

# Render every selected note (yours first), then the open-item list, then apply
# the budget: while the whole output is over CONTEXT_MAX_CHARS, other
# contributors' notes are dropped, furthest back first. The repo doc, your own
# note and the open-item list are never cut.
NOTE_TEXT=()
NOTE_MINE=()
NOTE_KEPT=()
N_NOTES=0
ITEMS_OUT=""
if [ -n "$SELECTED" ]; then
  while IFS="$TAB" read -r _date _mtime path who; do
    [ -n "$path" ] || continue
    mine=0
    [[ -n "$AUTHOR_SLUG" && "$who" = "$AUTHOR_SLUG" ]] && mine=1
    override=""
    [[ -n "$OLDER_PATH" && "$path" = "$OLDER_PATH" ]] && override="$OLDER_LABEL"
    NOTE_TEXT[N_NOTES]="$(render_note "$path" "$who" "$mine" "$override")"
    NOTE_MINE[N_NOTES]=$mine
    NOTE_KEPT[N_NOTES]=1
    N_NOTES=$((N_NOTES + 1))
  done <<EOF
$SELECTED
EOF
  ITEMS_OUT="$(print_open_items)"
fi

SIZE=$(( ${#HEAD_OUT} + ${#ITEMS_OUT} ))
i=0
while [ "$i" -lt "$N_NOTES" ]; do SIZE=$(( SIZE + ${#NOTE_TEXT[$i]} + 1 )); i=$((i + 1)); done
DROPPED=0
i=$((N_NOTES - 1))
while [ "$SIZE" -gt "$MAX_CHARS" ] && [ "$i" -ge 0 ]; do
  if [ "${NOTE_MINE[$i]}" = 0 ]; then
    NOTE_KEPT[i]=0
    SIZE=$(( SIZE - ${#NOTE_TEXT[$i]} - 1 ))
    DROPPED=$((DROPPED + 1))
  fi
  i=$((i - 1))
done

printf '%s\n' "$HEAD_OUT"
i=0
while [ "$i" -lt "$N_NOTES" ]; do
  [ "${NOTE_KEPT[$i]}" = 1 ] && printf '%s\n' "${NOTE_TEXT[$i]}"
  i=$((i + 1))
done
[ -n "$ITEMS_OUT" ] && printf '%s\n' "$ITEMS_OUT"
if [ "$DROPPED" -gt 0 ]; then
  echo
  echo "($DROPPED other note(s) left out to stay within CONTEXT_MAX_CHARS=$MAX_CHARS)"
fi
if [ "$SIZE" -gt "$MAX_CHARS" ]; then
  echo
  echo "(context exceeds CONTEXT_MAX_CHARS=$MAX_CHARS on its own; nothing more was dropped)"
fi
if [ -n "$SELECTED" ]; then
  if [ "$TOTAL" -gt "$MAX_CONTRIBUTORS" ]; then
    echo
    echo "($((TOTAL - MAX_CONTRIBUTORS)) more contributor(s) have notes too; CONTEXT_MAX_CONTRIBUTORS=$TOTAL would load them all)"
  fi
elif [ "$REPO_FILTERED" = 1 ]; then
  echo
  echo "(No daily notes yet for this repo.)"
else
  echo
  echo "(No daily notes in the vault yet.)"
fi
if [ -n "$OLDER_NOTE_LINE" ]; then
  echo
  echo "$OLDER_NOTE_LINE"
fi

exit 0
